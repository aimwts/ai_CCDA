# Copy to .env for local backend development. Keep real credentials out of Git.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require
DB_POOL_MAX=5
HISTORY_SAMPLE_INTERVAL_MS=60000
API_PORT=3000
WS_PORT=4000
WS_TOKEN=replace-with-a-long-random-value
CORS_ORIGIN=http://localhost:5173
